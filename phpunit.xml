<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_LOCALE" value="et"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="AUTHENTIK_CLIENT_ID" value=""/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!--
            Nothing here may talk to anybody. A developer's own .env is read by
            the test run too, so every credential that would turn a test into a
            real, billed request is blanked: without them each service takes the
            same "not configured" path it takes on CI, which is what the tests
            were written against. See Tests\TestCase, which turns a stray
            request into a failure rather than a phone call.
        -->
        <env name="ANTHROPIC_API_KEY" value=""/>
        <env name="PLANKA_URL" value=""/>
        <env name="PLANKA_ACCESS_TOKEN" value=""/>
        <env name="PLANKA_LIST_IDS" value=""/>
        <env name="JELLYFIN_URL" value=""/>
        <env name="JELLYFIN_API_KEY" value=""/>
        <env name="SENTRY_LARAVEL_DSN" value=""/>
        <env name="SENTRY_DSN" value=""/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_DATABASE" value="testing"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
